<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Inherit and extend the native Sale Order Form View -->
        <record id="view_order_form_inherit_loyalty_pricing" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.loyalty.pricing</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <!-- Place the Customer Loyalty Years field inside the main primary metadata group -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="customer_loyalty_years" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>